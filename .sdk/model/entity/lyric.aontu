# Entity: lyric

main: kit: entity: lyric: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    language: {
      h: "Language"
      n: "language"
      r: false
      sh: "Language of the lyrics"
      t: "`$STRING`"
    }
    lyrics: {
      h: "Lyrics"
      n: "lyrics"
      r: false
      sh: "Full lyrics of the song"
      t: "`$STRING`"
    }
    songId: {
      h: "Song Id"
      n: "songId"
      r: false
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "lyric"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/lyrics/{songId}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "song_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/lyrics/{songId}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              songId: "id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "lyrics"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
