# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: [
    {
      name: "album"
      req: false
      short: "Album name"
      type: "`$STRING`"
    }
    {
      name: "albumId"
      req: false
      short: "Album identifier"
      type: "`$STRING`"
    }
    {
      name: "artist"
      req: false
      short: "Primary artist of the song"
      type: "`$STRING`"
    }
    {
      name: "artists"
      req: false
      short: "List of all artists involved"
      type: "`$ARRAY`"
    }
    {
      format: "uri"
      name: "coverArt"
      req: false
      short: "URL to cover art image"
      type: "`$STRING`"
    }
    {
      name: "duration"
      req: false
      short: "Duration in seconds"
      type: "`$INTEGER`"
    }
    {
      name: "genre"
      req: false
      short: "Primary genre"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier of the song"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "releaseDate"
      req: false
      short: "Release date of the song"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the song"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "search"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "Shape of You"
                kind: "query"
                name: "query"
                orig: "query"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/search"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "search"
            }
          ]
          select: {
            exist: [
              "limit"
              "offset"
              "query"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
