# BasicSongFlow

main: kit: flow: BasicSongFlow:
{
  entity: "song",
  kind: "basic",
  name: "BasicSongFlow",
  step: [
    {
      i: {
        ref: "song_ref01",
        srcdatavar: "song_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "song01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-song_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSongFlow"
}